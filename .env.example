# =============================================================================
# GST Engine — environment template
# Copy to `.env` (git-ignored) and fill in. NEVER commit real secrets.
# All values here are read server-side only. None are exposed to the browser,
# theme extension, or customer-account extension.
# =============================================================================

# --- Runtime ---
NODE_ENV=development

# --- Shopify app (from Partners dashboard / `shopify app` config) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
SCOPES=read_products,write_products,read_customers,write_customers,read_orders,write_orders,read_files,write_files
SHOP_CUSTOM_DOMAIN=rinstruments.com

# --- Offline access token (single-store, Phase 1) ---
# Captured once after install; stored as a Vercel encrypted secret in production.
# Used by webhooks + the Vercel Cron invoice reconciler. See DECISIONS.md D7.
SHOPIFY_OFFLINE_ACCESS_TOKEN=

# --- GST verification provider (D-GST) ---
# GST_PROVIDER selects the adapter: "mock" (default until creds arrive) | "gstverify"
GST_PROVIDER=mock
GST_API_URL=
GST_API_KEY=
GST_API_AUTH_SCHEME=

# --- Email provider (D8) ---
# EMAIL_PROVIDER: "console" (dev) | "resend" | "ses" | "sendgrid"
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=

# --- Cron auth (protects the Vercel Cron invoice route) ---
CRON_SECRET=
