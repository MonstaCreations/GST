# =============================================================================
# GST Engine — environment template
# Copy to `.env` (git-ignored) and fill in. NEVER commit real secrets.
# All values here are read server-side only. None are exposed to the browser,
# theme extension, or customer-account extension.
# =============================================================================

# --- Runtime ---
NODE_ENV=development

# --- Database (Shopify SESSION storage ONLY — no GST business data) ---
# Prisma + PostgreSQL. Local dev: use the bundled docker-compose Postgres, a local
# install, or a hosted dev branch (Neon/Supabase). Production: set in Vercel env.
# Example (matches docker-compose.yml): postgresql://gst:gst@localhost:5432/gst_sessions
DATABASE_URL=

# --- Shopify app (from Partners dashboard / `shopify app` config) ---
# In production SHOPIFY_APP_URL becomes the Vercel deployment URL (see docs/DEPLOYMENT.md).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
SCOPES=read_products,write_products,read_customers,write_customers,read_orders,write_orders,read_files,write_files
SHOP_CUSTOM_DOMAIN=rinstruments.com

# --- Offline access token (single-store, Phase 1) ---
# Captured once after install; stored as a Vercel encrypted secret in production.
# Used by webhooks + the Vercel Cron invoice reconciler. See DECISIONS.md D7.
SHOPIFY_OFFLINE_ACCESS_TOKEN=

# --- GST verification provider (D-GST) ---
# GST_PROVIDER selects the adapter: "mock" (default) | "finagg" | "gstverify" (legacy stub).
# "finagg" never silently falls back to the mock provider: if the FINAGG_* values below
# are missing or unusable the app fails at boot with a clear message, not mid-checkout.
GST_PROVIDER=mock

# --- FinAGG GSP (Common GST Search API, action=SEARCHGSTIN) ---
# Required when GST_PROVIDER=finagg. Server-side only — never exposed to the browser,
# the theme extension, or the customer-account extension.
# Docs: https://developer.gsp.finagg.in/
# Request the key from the FinAGG GSP team (gsp@finagg.in).
FINAGG_API_KEY=
# Production origin. The sandbox origin is https://sandbox-gsp.finagg.in — but it is NOT a
# fake-data sandbox: FinAGG have confirmed GSTN provides no separate test environment, so
# use production with real taxpayer GSTINs unless FinAGG onboarding says otherwise.
FINAGG_BASE_URL=https://gsp.finagg.in
# Path segments {finaggVersion} / {gspVersion} of
# /basic/gstn/{finaggVersion}/commonapi/{gspVersion}/search
# The OpenAPI doc shows "fin-v1" and "v1.1" as examples — confirm the real values with FinAGG.
FINAGG_FINAGG_VERSION=
FINAGG_GSP_VERSION=
# Optional. Request timeout in ms (default 8000), and "false" to disable the single
# retry that transient failures (network / timeout / HTTP 503) are allowed.
FINAGG_TIMEOUT_MS=
FINAGG_RETRY=

# Legacy stub adapter (GST_PROVIDER=gstverify); unused by the FinAGG integration.
GST_API_URL=
GST_API_KEY=
GST_API_AUTH_SCHEME=

# --- Email provider (D8) ---
# EMAIL_PROVIDER: "console" (dev) | "resend" | "ses" | "sendgrid"
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=

# --- Cron auth (protects the Vercel Cron invoice route) ---
CRON_SECRET=
